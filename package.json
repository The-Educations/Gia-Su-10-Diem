{
  "name": "gia-su-10-diem",
  "version": "1.0.0",
  "description": "Vietnamese tutor marketplace with student, tutor and admin workspaces",
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/generate-assets.js",
    "build:page": "node scripts/build-page.js",
    "build": "npm run build:page && npm run build:app",
    "test": "node test/verify.js && node --test test/api.test.js test/google-auth.test.js",
    "dev": "node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "seed:demo": "node server/seed.js",
    "create:admin": "node server/create-admin.js",
    "build:app": "vite build",
    "typecheck": "tsc --noEmit",
    "test:api": "node --test test/api.test.js",
    "test:e2e": "npm run build:app && playwright test",
    "preview": "SERVE_BUILD=1 node server/index.js",
    "build:cloudflare": "npm run build && node scripts/build-cloudflare.js",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "test:cloudflare": "node test/cloudflare-smoke.mjs"
  },
  "keywords": [
    "landing-page",
    "tutoring",
    "threejs",
    "pixel-art",
    "open-design"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@animate-ui/react": "^2.4.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
